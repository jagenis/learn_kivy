from kivy.app import App
from kivy.uix.gridlayout import GridLayout
from kivy.uix.button import Button

class DemoGridLayout(App):
    def build(self):
        grid = GridLayout(cols=3, spacing=15, padding=10)
        for i in range(1, 10):
            grid.add_widget(Button(text=f"Botón {i}", size_hint=(0.5, 0.5), pos_hint={'center_x': 0.5, 'center_y': 0.5}))
        return grid

DemoGridLayout().run()
